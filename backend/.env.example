APP_ENV=development
APP_NAME=Real-Time Time-Series Intelligence Platform
APP_VERSION=0.2.0

DATABASE_URL=sqlite+aiosqlite:///./local_platform.db
ML_ENGINE_URL=http://127.0.0.1:8001

ENABLE_KAFKA_CONSUMERS=false
ENABLE_DEMO_STREAM=true
DEMO_SENSOR_ID=cryo_pump_A1
DEMO_TICK_SECONDS=1.5

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_METRIC_TOPIC=processed_features
KAFKA_ANOMALY_TOPIC=anomaly_events
KAFKA_ALERT_TOPIC=system_alerts

NASA_API_KEY=DEMO_KEY
NASA_LIVE_URL=https://api.nasa.gov/planetary/apod

# Point this to a JSON endpoint or cached CERN-style feed for local demos.
CERN_LIVE_URL=

EXTERNAL_TIMEOUT_SECONDS=15.0
